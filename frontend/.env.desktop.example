# Desktop shell build environment (npm run build:desktop / desktop:dev)
# Tauri serves the app from http://tauri.localhost on Windows — the backend
# must allowlist that origin (CORS_ORIGINS + better-auth trustedOrigins).
VITE_API_BASE_URL=https://api.jvaccounting.in/api/v1
VITE_APP_NAME=FirmDesk
VITE_APP_SHELL=desktop
VITE_DESKTOP_DOWNLOAD_URL=https://jvaccounting.in/desktop-download
VITE_DESKTOP_UPDATE_URL=https://jvaccounting.in/desktop-updates/manifest.json
