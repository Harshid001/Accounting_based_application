VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=FirmDesk
# web = client portal only (default); desktop = admin/staff Tauri shell
VITE_APP_SHELL=web
# Where staff download the desktop app (shown on the web interstitial)
VITE_DESKTOP_DOWNLOAD_URL=/desktop-download
# Update manifest URL for the desktop shell's updater (desktop only)
VITE_DESKTOP_UPDATE_URL=
# Off-by-default: never enable in production web builds (rule: web = clients)
VITE_WEB_STAFF_ACCESS=false
