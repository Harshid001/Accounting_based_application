#!/bin/sh
# Pre-commit hook: block accidental .env file commits
#
# Install: copy this file to .git/hooks/pre-commit and make it executable
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or wire it automatically via package.json "prepare" script with git config:
#   git config core.hooksPath .githooks
#
# Only Added/Copied/Modified/Renamed staged files are checked (ACMR), so that
# REMOVING a .env from the repository is always allowed — untracking secrets
# is exactly what this hook wants to encourage.

# Collect staged files that look like .env files (deletions excluded).
# .env.example and .env.template are documentation templates with no secrets
# and are intentionally allowed.
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -vE '\.env\.(example|template)$')

if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "  COMMIT BLOCKED - .env file(s) detected in staged changes"
  echo ""
  echo "  The following secret files were about to be committed:"
  for f in $ENV_FILES; do
    echo "    -  $f"
  done
  echo ""
  echo "  To unstage:  git reset HEAD <file>"
  echo "  To ignore:   ensure the file is in .gitignore"
  echo "  NEVER commit .env - use Render env vars or a secrets vault"
  echo ""
  exit 1
fi

exit 0
