NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017/firmdesk

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes-not-this-string
BETTER_AUTH_URL=http://localhost:4000
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=000000000000-examplegoogleclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=EXAMPLE-google-client-secret-value

FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_KEY_VERSION=1

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=firmdesk@example.test
SMTP_PASSWORD=EXAMPLE-smtp-password
MAIL_FROM="FirmDesk <firmdesk@example.test>"

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
COMPLIANCE_HORIZON_DAYS=120

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
