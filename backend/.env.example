NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017/firmdesk

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost

BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes-not-this-string
BETTER_AUTH_URL=http://localhost:4000
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=000000000000-examplegoogleclientid.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=EXAMPLE-google-client-secret-value

FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_KEY_VERSION=1

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=firmdesk@example.test
SMTP_PASSWORD=EXAMPLE-smtp-password
MAIL_FROM="FirmDesk <firmdesk@example.test>"

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
COMPLIANCE_HORIZON_DAYS=120
AUTOMATION_HEADLESS=true

# Desktop shell version gate: outdated desktops get a hard update wall at login.
DESKTOP_MIN_SHELL_VERSION=0.1.0
DESKTOP_LATEST_SHELL_VERSION=0.1.0
DESKTOP_UPDATE_URL=https://jvaccounting.in/desktop-download

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# AI Copilot (optional — the app runs without it, chat falls back to static answers)
# AI_PROVIDER: gemini | openai | custom. Auto-detected from whichever API key is set.
# Gemini (recommended): create a key at https://aistudio.google.com/apikey
# OpenAI: create a key at https://platform.openai.com/api-keys
# Custom / Xkiro / OpenAI-compatible endpoint (e.g. Xkiro with DeepSeek):
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XTROUTER_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=https://api.xkiro.com/v1
CUSTOM_AI_MODEL=deepseek/deepseek-v4-pro

# Cloudflare R2 object storage
# Account ID: Cloudflare Dashboard → right sidebar "Account ID"
# Access key pair: R2 → Manage R2 API tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
